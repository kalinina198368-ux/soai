.login-container{
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--card-bg) !important
  background-color: var(---card-bg) !important

  .login-box{
    width: 410px;
    padding: 20px;
   
  }
}

.form-title{
  color:var( --text-theme-color)
}

.wechatLog{
  width: 410px;
  height: 50px;
  line-height: 50px;
  text-align: center
  background: var( --sign-bg)
  a{
    color: var(--text-theme-color)

  }
  font-size: 14px;
  margin-bottom: 26px
  border-radius: 16px;
  .icon-wechat{
    color: #0bc15f
    margin-right: 9px
    font-size: 20px;
  }
}

.text-color-primary{
  cursor :pointer
}

.login-btn {
  width :100%
  height: 48px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
}

.code-input{
  width: 306px;
  margin-right: 9px;
}

:deep(.el-tabs__item.is-active), :deep(.el-tabs__item:hover) {
  color: var(--common-text-color) !important
}

:deep(.el-tabs__item) {
  color: var(--text-theme-color)
}